# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Token LMS Rikkei (tùy chọn - nếu có sẵn token thì không cần đăng nhập qua IMAP)
LMS_TOKEN=your_bearer_token_here

# Cấu hình tài khoản LMS Rikkei (dùng để tự động đăng nhập khi token hết hạn)
RIKKEI_USERNAME=your_username
RIKKEI_PASSWORD=your_password

# Cấu hình IMAP Lark Suite để tự động nhận mã OTP
EMAIL_USER=your_lark_email@rikkeisoft.com
EMAIL_APP_PASSWORD=your_lark_app_password
